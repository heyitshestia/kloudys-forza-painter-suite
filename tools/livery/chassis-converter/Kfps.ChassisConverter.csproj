<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="vendor\**\*.cs" />
    <Compile Include="vendor\ForzaTechStudio\ModelImporter.cs" Link="Vendor\ModelImporter.cs" />
    <ProjectReference Include="vendor\ForzaTechStudio\ForzaTools.Bundles\ForzaTools.Bundles.csproj" />
    <ProjectReference Include="vendor\ForzaTechStudio\ForzaTools.Shared\ForzaTools.Shared.csproj" />
    <ProjectReference Include="vendor\ForzaTechStudio\DurangoTypes\DurangoTypes.csproj" />
  </ItemGroup>
</Project>
