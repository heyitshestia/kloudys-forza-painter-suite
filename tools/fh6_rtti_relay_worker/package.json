{
  "name": "kfps-fh6-rtti-relay-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply kfps-fh6-rtti --local",
    "migrate:remote": "wrangler d1 migrations apply kfps-fh6-rtti --remote"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.6"
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.12",
    "wrangler": "^4.110.0"
  }
}
